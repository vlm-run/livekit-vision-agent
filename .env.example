# LiveKit project. `lk app create` can fill these in.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# VLM Run key. The agent holds it; the browser never sees it.
VLMRUN_API_KEY=

# A model with a realtime block (a generative chat model is refused on the socket).
# The demo page overrides this per viewer.
VLMRUN_MODEL=usyd-community/vitpose-plus-large

# Optional, with their defaults:
#   VLMRUN_METHOD      the model's default method (set it to pick e.g. detect or segment)
#   VLMRUN_PROMPT      what SAM segments, or the question for a chat model
#   VLMRUN_PARAMS      JSON method_params, e.g. {"bbox_xywh": [0.1, 0.1, 0.4, 0.5]} for segment_box
#   VISION_FPS         8; a local cap, the session also enforces the model's max_fps
#   VLMRUN_GATEWAY_WS  wss://gateway.vlm.run/v1/ws
#   DEMO_ROOM          vlmrun-vision; the prefix of the rooms the demo page creates
